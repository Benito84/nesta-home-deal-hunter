# NESTA DEAL HUNTER SZCZECIN - CONFIGURATION

# Serwer
APP_PORT=8000
DEBUG=True

# Google Gemini API (dla AI Evaluator i ekstrakcji ogłoszeń)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot (dla alertów na telefon "DZWONIMY / SUPER OKAZJA")
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Nesta Master Tracker Integration
TRACKER_ENV=DEV
TRACKER_DEV_URL=http://srv75.mikr.us:30120/api/staging
TRACKER_PROD_URL=http://srv75.mikr.us:20120/api/staging

# Poczta IMAP (Alerty e-mail z OLX / Otodom)
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=alerty@twojadomena.pl
IMAP_PASSWORD=twoje_haslo_poczty
IMAP_FOLDER=INBOX

# Parametry Inwestycyjne
DEFAULT_MIN_ROI=0.16
MIN_NET_PROFIT_PLN=30000.0
